# Copy this file to .env.local for local work, and add the same three values
# in the Vercel project under Settings > Environment Variables.

# Connection string from your Postgres provider (for example Neon).
DATABASE_URL=

# The password for the /admin page. Pick a long one.
ADMIN_PASSWORD=change-me-to-a-long-password

# Any long random text. It signs the admin session and hashes visitor addresses.
SESSION_SECRET=

# The assistant. Any provider with an OpenAI-compatible API works (Groq, OpenAI, Gemini and others).
# Leave LLM_API_KEY unset to switch the assistant off: the chat button then points people to the contact page.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# The most assistant messages answered per day across the whole site. This caps your cost.
CHAT_DAILY_CAP=
